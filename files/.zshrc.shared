export STARSHIP_CONFIG=~/.starship.toml

export PATH="$PATH:$HOME/.dotnet/tools"
export PATH="$PATH:$HOME/workspace/dotfiles/shared/bin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin:$PATH"

export AWS_PAGER=""

(fix-claude-symlinks &) >/dev/null 2>&1

fpath=(/Applications/Docker.app/Contents/Resources/etc $fpath)

[[ -f ~/.aliases.zsh ]] && source ~/.aliases.zsh
[[ -f ~/.rtm.zsh ]] && source ~/.rtm.zsh
[[ -f ~/.iterm2_shell_integration.zsh ]] && source ~/.iterm2_shell_integration.zsh

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history       # record timestamp of command in HISTFILE
setopt hist_expire_dups_first # delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt hist_ignore_dups       # ignore duplicated commands history list
setopt hist_ignore_space      # ignore commands that start with space
setopt hist_verify            # show command with history expansion to user before running it
setopt share_history          # share command history data between sessions

source ~/.antidote/antidote.zsh

antidote load

# Generating completions forks each CLI (~200ms total), so cache the output and
# regenerate only when the resolved binary path changes (e.g. after brew upgrade).
_zcomp_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions
[[ -d $_zcomp_dir ]] || mkdir -p $_zcomp_dir
fpath=($_zcomp_dir $fpath)

_zcomp_cache() {
  local name=$1 out=$2; shift 2
  local bin=${commands[$name]:A} stamp=$_zcomp_dir/.$name.stamp
  [[ -n $bin ]] || return 1
  [[ -s $out && -r $stamp && "$(<$stamp)" == $bin ]] && return 0
  if "$@" >| $out.tmp 2>/dev/null && [[ -s $out.tmp ]]; then
    command mv -f $out.tmp $out && print -r -- $bin >| $stamp
    # compinit -C below won't notice new fpath files on its own.
    command rm -f ${ZDOTDIR:-$HOME}/.zcompdump
  else
    command rm -f $out.tmp
  fi
}

_zcomp_cache flux    $_zcomp_dir/_flux    flux completion zsh
_zcomp_cache kubectl $_zcomp_dir/_kubectl kubectl completion zsh
_zcomp_cache docker  $_zcomp_dir/_docker  docker completion zsh
_zcomp_cache gh      $_zcomp_dir/_gh      gh completion -s zsh
# op ships _op in Homebrew's site-functions, so it needs nothing here.

# Skip the fpath security audit and rescan unless the dump is over a day old.
autoload -Uz compinit
_zcompdump=${ZDOTDIR:-$HOME}/.zcompdump
_zcomp_stale=($_zcompdump(N.mh+24))
if [[ ! -f $_zcompdump || -n $_zcomp_stale ]]; then
  compinit && touch $_zcompdump
else
  compinit -C
fi
unset _zcompdump _zcomp_stale

# Pulumi's script is bash-compat glue that has to be sourced, not autoloaded.
_zcomp_cache pulumi $_zcomp_dir/pulumi.zsh pulumi gen-completion zsh && source $_zcomp_dir/pulumi.zsh
unset _zcomp_dir
unfunction _zcomp_cache

# Up/Down arrow: search history for commands starting with the current input, cursor at end
autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search    # Up arrow (normal mode, e.g. raw terminal)
bindkey '^[[B' down-line-or-beginning-search  # Down arrow (normal mode)
bindkey '^[OA' up-line-or-beginning-search    # Up arrow (application mode, e.g. inside tmux)
bindkey '^[OB' down-line-or-beginning-search  # Down arrow (application mode)

# Ctrl+K: clear screen + scrollback at empty prompt; otherwise default kill-line
ctrl-k-smart() {
  if [[ -z $BUFFER ]]; then
    zle clear-screen
    printf '\033[3J' > /dev/tty
  else
    zle kill-line
  fi
}
zle -N ctrl-k-smart
bindkey '^K' ctrl-k-smart

# Option+Arrow: move by word
bindkey '^[b' backward-word        # Option+Left (Esc+ mode)
bindkey '^[f' forward-word         # Option+Right (Esc+ mode)
bindkey '^[[1;3D' backward-word    # Option+Left (xterm/iTerm2 default)
bindkey '^[[1;3C' forward-word     # Option+Right (xterm/iTerm2 default)

eval "$(starship init zsh)"
eval "$(mise activate zsh)"
export MISE_EXPERIMENTAL=1
export MISE_LOG_LEVEL=warn
